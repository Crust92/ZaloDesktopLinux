<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ac.d3v.ZaloLinux</id>

  <name>Zalo Desktop</name>
  <summary>Ứng dụng nhắn tin Zalo cho Linux</summary>
  <summary xml:lang="en">Zalo messaging client for Linux</summary>

  <!-- Zalo la phan mem doc quyen cua Zalo Group (VNG). Ban dong goi nay khong
       phai san pham chinh thuc cua ho; xem ghi chu trong <description>. -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://zalo.me/dieu-khoan-su-dung</project_license>

  <developer id="ac.d3v">
    <name>d3v</name>
  </developer>

  <description>
    <p>
      Zalo la ung dung nhan tin pho bien tai Viet Nam. Zalo Group co phat hanh
      ban desktop cho Windows va macOS nhung chua co ban Linux chinh thuc.
    </p>
    <p>
      Ban dong goi nay chay chinh ma nguon Zalo Desktop chinh thuc tren Electron,
      kem mot lop tuong thich Linux cho nhung module nen tang ma Zalo chua phat
      hanh cho he dieu hanh nay. Khong phai ban mo phong, khong dung Wine.
    </p>
    <p>Tinh nang:</p>
    <ul>
      <li>Nhan tin ca nhan va nhom, dong bo voi dien thoai</li>
      <li>Gui anh, video, tap tin</li>
      <li>Thong bao he thong, bieu tuong khay</li>
      <li>Tang toc ket xuat bang GPU khi may co, tu dong lui ve phan mem khi khong</li>
    </ul>
    <p>
      Day khong phai ban phat hanh chinh thuc cua Zalo Group. Moi thac mac ve
      dich vu Zalo xin lien he truc tiep nha phat hanh.
    </p>
  </description>

  <launchable type="desktop-id">ac.d3v.ZaloLinux.desktop</launchable>

  <url type="homepage">https://zalo.me</url>
  <url type="bugtracker">https://github.com/Crust92/ZaloDesktopLinux/issues</url>
  <url type="vcs-browser">https://github.com/Crust92/ZaloDesktopLinux</url>

  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
    <category>Chat</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>

  <!-- Anh chup man hinh: bo sung URL that truoc khi gui len store.
       Flathub doi it nhat mot anh, kich thuoc toi thieu 620x351.
